# Supabase - optional. If set, data syncs across devices.
# Create a project at https://supabase.com and run supabase/schema.sql in SQL Editor.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App configuration - optional overrides (defaults in src/config.js)
VITE_WORK_HOURS_MIN=7
VITE_WORK_HOURS_MAX=17
# Reference date for age calculations (Expected Entry). Month 0-indexed (8 = September).
VITE_REFERENCE_DATE_YEAR=2026
VITE_REFERENCE_DATE_MONTH=8
VITE_REFERENCE_DATE_DAY=1
